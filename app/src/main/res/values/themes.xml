<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base theme; all actual styling happens in Compose (ui/theme). -->
    <style name="Theme.CinematicStudio" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/studio_background</item>
        <item name="android:statusBarColor">@color/studio_status_bar</item>
        <item name="android:navigationBarColor">@color/studio_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorAccent">@color/studio_accent</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
